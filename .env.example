# ──────────────────────────────────────────────────────────────
#  Copia este archivo a `.env` y rellena los valores reales.
#  `.env` está en .gitignore — nunca lo subas al repositorio.
#
#  Los valores se toman del Dashboard de Supabase:
#  Project Settings → API
# ──────────────────────────────────────────────────────────────

# URL del proyecto de Supabase. Se usa para las Edge Functions
# (`${VITE_SUPABASE_URL}/functions/v1/...`) y para el cliente JS del panel.
VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co

# Clave anónima (pública). Viaja en el bundle del frontend: NO es un secreto,
# pero tampoco da acceso a las tablas — el rol `anon` está bloqueado por RLS.
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.xxxxxxxxxxxx

# Dominio público del sitio. El panel lo usa para construir los links de
# invitación que se envían por WhatsApp. Sin barra final.
# Si se omite, el panel usa `window.location.origin`.
VITE_APP_URL=https://boda-angely-kevin.example.com
