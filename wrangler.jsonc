{
  // Worker que sirve la plataforma: invitation.kdealbap.com y los subdominios de
  // cada evento. Push a master = publicar (Workers Builds).
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "weddingskya",
  "compatibility_date": "2026-06-15",
  // Solo /fotos/* y /api/* pasan por el código (worker/index.js); el resto son
  // estáticos servidos directo, como antes.
  "main": "worker/index.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Cualquier ruta que no sea un archivo (/i/<token>, /admin/…) cae en index.html
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/fotos/*", "/api/*"]
  },
  // Las fotos que sube el admin de cada evento
  "r2_buckets": [{ "binding": "FOTOS", "bucket_name": "invitation-fotos" }],
  // Públicos (los mismos de .env.production): el Worker pregunta a Supabase por permisos
  "vars": {
    "SUPABASE_URL": "https://sooujrdkxvfnnmjkajkh.supabase.co",
    "SUPABASE_ANON_KEY": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InNvb3VqcmRreHZmbm5tamthamtoIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODE0NTQxNjgsImV4cCI6MjA5NzAzMDE2OH0.M2te2osNqrYyFdvFQy8zbN48K9GEw3umpwZUtCmzgwA"
  }
}
